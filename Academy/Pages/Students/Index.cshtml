@page
@model Academy.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Index";
}

<style>
    /*styles for the same column width during pagination and filtration*/
    .table-responsive-fixed-width {
        width: 100%;
        overflow-x: auto; 
        -webkit-overflow-scrolling: touch; 
    }
     
        .table-responsive-fixed-width .table {
            width: 100%; 
            table-layout: fixed;
            border-collapse: collapse;
        }

            .table-responsive-fixed-width .table th,
            .table-responsive-fixed-width .table td {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

                .table-responsive-fixed-width .table th:nth-child(1),
                .table-responsive-fixed-width .table td:nth-child(1) {
                    width: 50%;
                }

                .table-responsive-fixed-width .table th:nth-child(2),
                .table-responsive-fixed-width .table td:nth-child(2) {
                    width: 30%;
                }

            .table-responsive-fixed-width .table a {
                display: inline-block; 
                width: 100%;
                text-overflow: ellipsis;
                overflow: hidden;
                white-space: nowrap;
            }
    /*for links colors*/
    p .create-new-link {
        color: purple;
    }

        p .create-new-link:hover {
            color: darkorchid;
        }
    table .create-new-link {
        color: purple;
    }

        table .create-new-link:hover {
            color: darkorchid;
        }

    h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #4B0082;
    }

    h2 {
        color: #7B68EE;
    }
    p {
        text-align: center;
    }

    th {
        color: #4169E1;
    }

    .form-group-margin-top {
        margin-top: 20px;
    }
    /*Edit, details, delete*/
    .actions-cell {
        display: flex;
        justify-content: space-around;
        align-items: center;
    }

    .action-link {
        display: inline-block;
        flex: 1 1 auto;
        text-align: center; 
        text-decoration: none;
    }

    /* Если нужно, чтобы кнопки были примерно одинаковой ширины */
    .action-link {
        flex: 1; /* Каждый элемент займет равную долю */
        text-align: center;
    }
    /*for buttons colors*/
    .custom-purple-button.btn-primary {
        background-color: #8A2BE2;
        border-color: #4B0082;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1), 
                    0 2px 4px rgba(0, 0, 0, 0.08);
        color: white;
    }

        .custom-purple-button.btn-primary:hover {
            background-color: #BA55D3;
            border-color: darkorchid;
            box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15), 
                        0 3px 6px rgba(0, 0, 0, 0.12);
        }
    
    .custom-purple-button.disabled {
        background-color: #D3D3D3;
        border-color: #D3D3D3;
        color: #6c757d;
    }

</style>


<h1>👦🏻Index👧🏻</h1>

<div class="header">
    <div style="display:flex;">
        <h2>Students</h2>
        <div style="margin: 0px 20px;">
            <a asp-page="Create" class="btn btn-primary custom-purple-button">Create new student</a>
        </div>
    </div>

    <form asp-page="./Index" method="get">
        <div class="form-actions no-color">
            <p>
                Find by name🔎:
                <input type="text" name="searchString" value="@Model.CurrentFilter" />
                <input type="submit" value="Search" class="btn btn-primary custom-purple-button" /> |
                <a asp-page="./Index" class="create-new-link">Back to full List</a>
            </p>
        </div>
    </form>
</div>

<div class="table-responsive-fixed-width">
    <table class="table create-new-link">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Index" asp-route-sortOrder="@Model.NameSort" asp-route-currentFilter="@Model.CurrentFilter">@Html.DisplayNameFor(model => model.Students[0].FullName)</a>
                </th>
                @*  <th>
                @Html.DisplayNameFor(model => model.Student[0].last_name)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.Student[0].first_name)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.Student[0].middle_name) *@
                @* </th> *@
                @*  <th>
                @Html.DisplayNameFor(model => model.Student[0].birth_date)
                </th> *@
                <th>
                    <a asp-page="./Index" asp-route-sortOrder="@Model.DateSort" asp-route-currentFilter="@Model.CurrentFilter">@Html.DisplayNameFor(model => model.Students[0].birth_date)</a>
                </th>
                @*     <th>
                @Html.DisplayNameFor(model => model.Student[0].email)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.Student[0].phone)
                </th>
                <th>
                @Html.DisplayNameFor(model => model.Student[0].photo) *@
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Students) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FullName)
                </td>
                @* <td>
                @Html.DisplayFor(modelItem => item.last_name)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.first_name)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.middle_name)
                </td> *@
                <td>
                    @Html.DisplayFor(modelItem => item.birth_date)
                </td>
                @*      <td>
                @Html.DisplayFor(modelItem => item.email)
                </td>
                <td>
                @Html.DisplayFor(modelItem => item.phone)
                </td> *@
                @*             <td>
                @Html.DisplayFor(modelItem => item.photo)
                </td> *@
                <td class="actions-cell">
                    <a asp-page="./Edit" class="action-link create-new-link" asp-route-id="@item.stud_id">Edit</a> |
                    <a asp-page="./Details" class="action-link create-new-link" asp-route-id="@item.stud_id">Details</a> |
                    <a asp-page="./Delete" class="action-link create-new-link" asp-route-id="@item.stud_id">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
@{
    string prevDisabled = Model.Students.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.Students.HasNextPage ? "" : "disabled";
}
<a asp-page="./Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.Students.PageIndex - 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   asp-route-pageSize="@Model.PageSize"
   class="btn btn-primary @prevDisabled custom-purple-button">
    Prev
</a>
<a asp-page="./Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.Students.PageIndex + 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   asp-route-pageSize="@Model.PageSize"
   class="btn btn-primary @nextDisabled custom-purple-button">
    Next
</a>
<form class="form-group-margin-top" asp-page="./Index" method="get">
    <select asp-for="PageSize" onchange="this.form.submit()">
        <option value="3">3</option>
        <option value="5">5</option>
        <option value="8">8</option>
        <option value="10">10</option>
    </select>
</form>
